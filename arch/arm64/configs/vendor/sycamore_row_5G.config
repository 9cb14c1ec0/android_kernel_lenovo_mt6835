# Lenovo TB336ZA (sycamore_row_5G), MediaTek MT6835.
#
# Applied on top of gki_defconfig. The stock firmware loads MediaTek's own
# zsmalloc.ko (vendor_ramdisk) and zram_ext.ko (vendor_dlkm), so the GKI
# zram/zsmalloc modules are not built. Neither option affects vmlinux or the
# KMI.
# CONFIG_ZRAM is not set
# CONFIG_ZSMALLOC is not set
